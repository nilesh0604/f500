name: Vyasa RAG - Deploy

on:
  push:
    branches: [main]
    paths:
      - 'apps/vyasa-rag-service/**'
      - 'infra/lib/vyasa-lambda-stack.ts'
      - 'libs/shared-types/**'
  workflow_dispatch:

concurrency:
  group: vyasa-rag-deploy
  cancel-in-progress: false

env:
  AWS_REGION: us-east-1
  NODE_VERSION: '22'

jobs:
  deploy:
    name: Build & Deploy
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment:
      name: production

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npx nx build vyasa-rag-service

      - name: Deploy CDK stacks
        run: |
          cd infra
          npx cdk deploy OrderFlow-VyasaVector OrderFlow-VyasaRag \
            --require-approval never

      - name: Smoke test
        run: |
          ENDPOINT=$(aws cloudformation describe-stacks \
            --stack-name OrderFlow-VyasaRag \
            --query 'Stacks[0].Outputs[?ExportName==`OrderFlow-VyasaRag-FunctionUrl`].OutputValue' \
            --output text)
          sleep 20
          curl -sf "${ENDPOINT}/health" -o /dev/null || exit 1
          echo "Smoke test passed: ${ENDPOINT}"

      - name: Notify Slack
        uses: 8398a7/action-slack@v3
        if: always()
        continue-on-error: true
        with:
          status: ${{ job.status }}
          text: 'Vyasa RAG deployed'
          webhook_url: ${{ secrets.SLACK_WEBHOOK_URL }}
