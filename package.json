{
  "name": "orderflow",
  "version": "0.1.0",
  "description": "OrderFlow - Real-Time Order Management System",
  "license": "UNLICENSED",
  "private": true,
  "author": "OrderFlow Team",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "test:ci": "nx run-many --target=test --all --configuration=ci",
    "lint": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky || true",
    "workspace-generator": "nx workspace-generator",
    "cdk:bootstrap": "cd infra && cdk bootstrap",
    "cdk:diff": "cd infra && cdk diff",
    "cdk:deploy": "cd infra && cdk deploy",
    "cdk:destroy": "cd infra && cdk destroy",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
