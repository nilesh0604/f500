{
  "name": "order-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/order-service/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["dist/apps/order-service"],
      "options": {
        "commands": [
          "npx prisma generate --schema=apps/order-service/prisma/schema.prisma",
          "rm -rf dist/apps/order-service && npx esbuild apps/order-service/src/main.ts --bundle --platform=node --outfile=dist/apps/order-service/main.js --external:bcrypt --external:@prisma/client"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "order-service:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/order-service/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/order-service"],
      "options": {
        "jestConfig": "apps/order-service/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "test:smoke": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx jest --config=apps/order-service/jest.config.ts --testPathPattern=smoke --passWithNoTests=false --detectOpenHandles"
        ]
      }
    }
  }
}
