# Local development environment variables
# Copy this file to .env.local and fill in your values

# AWS Configuration (uses your default AWS profile or these credentials)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Bedrock Knowledge Base ID (required for RAG)
BEDROCK_KB_ID=your_kb_id_here

# DynamoDB Tables (will use real AWS tables)
SESSIONS_TABLE=vyasa-rag-sessions-dev
RATE_LIMITS_TABLE=vyasa-rag-rate-limits-dev

# S3 Bucket for prompts
PROMPTS_BUCKET=vyasa-rag-prompts-dev

# Model ARNs
CLAUDE_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-sonnet-20240229-v1:0
TITAN_EMBED_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0

# Application Settings
MAX_AGENT_ITERATIONS=3
SESSION_TTL_DAYS=7
LOG_LEVEL=debug

# Optional: X-Ray (disabled for local)
AWS_XRAY_CONTEXT_MISSING=LOG_ERROR
AWS_XRAY_TRACING_NAME=vyasa-rag-local
