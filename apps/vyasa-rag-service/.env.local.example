# Local development environment variables
# Copy this file to .env.local and fill in your values

# AWS Configuration (uses your default AWS profile or these credentials)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Bedrock Knowledge Base ID (required for RAG)
BEDROCK_KB_ID=your_kb_id_here

# DynamoDB Tables (will use real AWS tables)
SESSIONS_TABLE=vyasa-rag-sessions-dev
RATE_LIMITS_TABLE=vyasa-rag-rate-limits-dev

# S3 Bucket for prompts
PROMPTS_BUCKET=vyasa-rag-prompts-dev

# Model ARNs
CLAUDE_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-sonnet-20240229-v1:0
TITAN_EMBED_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0

# Application Settings
MAX_AGENT_ITERATIONS=3
SESSION_TTL_DAYS=7
LOG_LEVEL=debug

# Optional: X-Ray (disabled for local)
AWS_XRAY_CONTEXT_MISSING=LOG_ERROR
AWS_XRAY_TRACING_NAME=vyasa-rag-local

# Langfuse Integration (optional, for evaluation)
# Replace placeholders with your own Langfuse project keys from
# https://cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_SECRET_KEY="sk-lf-YOUR_SECRET_KEY"
LANGFUSE_PUBLIC_KEY="pk-lf-YOUR_PUBLIC_KEY"
LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse MCP Server Auth (Base64 encoded "public_key:secret_key")
# Generate with: echo -n "pk-lf-xxx:sk-lf-xxx" | base64
LANGFUSE_MCP_AUTH=YOUR_BASE64_ENCODED_PUBLIC_COLON_SECRET

# API endpoint for Langfuse evaluation (set to local or deployed API)
VYASA_API_ENDPOINT=http://localhost:3000/api/rag
VYASA_API_KEY=your_api_key_if_required
VYASA_API_TIMEOUT=30000
