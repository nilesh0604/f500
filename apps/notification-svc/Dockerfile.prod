# Multi-stage Dockerfile for Notification Service
# This Dockerfile assumes the application is built on the host first
# Usage: npm run build && docker build -f Dockerfile.prod .

# Stage 1: Production dependencies
FROM node:22-alpine AS dependencies

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm install --omit=dev --legacy-peer-deps && npm cache clean --force

# Stage 2: Runtime
FROM node:22-alpine AS runtime

# Install wget for health checks
RUN apk add --no-cache wget

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

# Copy production dependencies
COPY --from=dependencies --chown=appuser:appgroup /app/node_modules ./node_modules

# Copy built application (requires pre-building on host)
COPY --chown=appuser:appgroup dist/apps/notification-svc/main.js ./dist/main.js
COPY --chown=appuser:appgroup package.json ./

# Switch to non-root user
USER appuser

# Expose application port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:3002/health || exit 1

# Start application
CMD ["node", "dist/main.js"]
