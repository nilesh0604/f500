{
  "name": "notification-svc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/notification-svc/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["dist/apps/notification-svc"],
      "options": {
        "commands": [
          "rm -rf dist/apps/notification-svc && npx esbuild apps/notification-svc/src/main.ts --bundle --platform=node --outfile=dist/apps/notification-svc/main.js"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": { "buildTarget": "notification-svc:build" }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": { "lintFilePatterns": ["apps/notification-svc/**/*.ts"] }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/notification-svc"],
      "options": {
        "jestConfig": "apps/notification-svc/jest.config.ts",
        "passWithNoTests": false
      }
    }
  }
}
