# Local development environment variables
# Copy this file to .env.local and fill in your values

# Server
PORT=3000

# Dev Mode: Set to 'true' to skip Slack signature verification
# WARNING: Only use for local testing, never in production
DEV_MODE=true

# Slack Signing Secret (get from Slack App: https://api.slack.com/apps -> Your App -> Settings -> App Credentials)
# In dev mode (DEV_MODE=true), this is optional
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Vyasa RAG API (uses real AWS API Gateway)
VYASA_API_BASE_URL=https://lkbzhoe1pj.execute-api.us-east-1.amazonaws.com
RAG_TIMEOUT_MS=28000
