{
  "name": "vyasa-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vyasa-ui/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/vyasa-ui/dist"],
      "options": {
        "command": "npm run build",
        "cwd": "{workspaceRoot}/apps/vyasa-ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/vyasa-ui"],
      "options": {
        "command": "npm run test",
        "cwd": "{workspaceRoot}/apps/vyasa-ui"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run lint",
        "cwd": "{workspaceRoot}/apps/vyasa-ui"
      }
    }
  },
  "tags": ["frontend", "react", "vyasa"]
}
