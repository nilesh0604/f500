# Vyasa UI environment variables
# Copy to .env.local and fill in values

# URL of the deployed vyasa-rag-service (Lambda URL or API Gateway)
# In dev the Vite proxy rewrites /api -> this URL
VITE_VYASA_API_URL=http://localhost:3000

# Optional: override the API base path used by the app
# Defaults to /api (proxied in dev, direct URL in prod)
VITE_API_BASE_PATH=/api
