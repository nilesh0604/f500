{
  "family": "orderflow-prod-order-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/orderflow-prod-order-exec",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/orderflow-prod-order-task",
  "containerDefinitions": [
    {
      "name": "order-service",
      "image": "${ECR_REGISTRY}/orderflow/order-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:/orderflow/prod/database/credentials:connection::"
        },
        {
          "name": "JWT_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:/orderflow/prod/jwt:privateKey::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/orderflow/prod/order-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "order-service"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ],
      "stopTimeout": 30
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "prod"
    },
    {
      "key": "Project",
      "value": "orderflow"
    },
    {
      "key": "Service",
      "value": "order-service"
    }
  ]
}
