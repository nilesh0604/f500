{
  "family": "orderflow-staging-notification-svc",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/orderflow-staging-notif-exec",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/orderflow-staging-notif-task",
  "containerDefinitions": [
    {
      "name": "notification-svc",
      "image": "${ECR_REGISTRY}/orderflow/notification-svc:staging-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "staging"
        },
        {
          "name": "PORT",
          "value": "3001"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/orderflow/staging/notification-svc",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "notification-svc"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3001/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "staging"
    },
    {
      "key": "Project",
      "value": "orderflow"
    },
    {
      "key": "Service",
      "value": "notification-svc"
    }
  ]
}
